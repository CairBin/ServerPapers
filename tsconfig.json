{
    "compilerOptions": {
        "outDir":"build",
        "rootDir": "./src",
        "target":"ES6",
        "module":"CommonJS",
        "sourceMap": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
}